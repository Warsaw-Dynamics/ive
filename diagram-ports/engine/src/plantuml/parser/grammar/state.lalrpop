// Original grammar for the supported MIT state subset; semantic traces are in provenance.
grammar(builder: &mut crate::plantuml::state::Builder<'_>);
use crate::plantuml::{state::{Caption, Declaration, Name}, parser::{state::{Token, join_shaft, require_adjacent}, error::ParseFailure}};
use std::ops::Range;

pub State: () = <Items>;
Items: () = { => (), <Items> <Item> =>? builder.tick().map_err(|error| lalrpop_util::ParseError::User { error }) };
Item: () = {
    <start:@L> "state" "gap" <value:Declaration> <label:DescriptionLabel> "newline" <end:@R> =>? builder.declare((value, label), start..end).map_err(|error| lalrpop_util::ParseError::User { error }),
    <_open:CompositeOpen> <_items:Items> <_closer:Closer> "newline" =>? builder.close().map_err(|error| lalrpop_util::ParseError::User { error }),
    <start:@L> <name:LeftName> <_colon:DescriptionColon> <label:"label"> "newline" <end:@R> =>? builder.describe((name, label), start..end).map_err(|error| lalrpop_util::ParseError::User { error }),
    <start:@L> <left:LeftEndpoint> <reverse:Arrow> <right:Endpoint> <label:Label> "newline" <end:@R> =>? builder.transition((left, right, reverse, label), start..end).map_err(|error| lalrpop_util::ParseError::User { error }),
};
CompositeOpen: () = <start:@L> "state" "gap" <value:Declaration> <_opener:Opener> "newline" <end:@R> =>? builder.open(value, start..end).map_err(|error| lalrpop_util::ParseError::User { error });
Opener: () = { "{", "begin" };
Closer: () = { "}", "endstate", "end" "state" <Gap> };
Gap: () = { => (), "gap" };
Declaration: Declaration = {
    <one:Name> =>? builder.single(one).map_err(|error| lalrpop_util::ParseError::User { error }),
    <start:@L> <left:Name> "as" <right:Name> <end:@R> =>? builder.alias((left, right), start..end).map_err(|error| lalrpop_util::ParseError::User { error }),
};
Name: Name = {
    <PlainName>,
    "state" <Gap> => Name { text: "state".into(), quoted: false },
};
LeftName: Name = {
    <PlainName>,
    "state" => Name { text: "state".into(), quoted: false },
};
PlainName: Name = {
    <value:"name"> => value,
    "as" => Name { text: "as".into(), quoted: false },
    "begin" => Name { text: "begin".into(), quoted: false },
    "end" => Name { text: "end".into(), quoted: false },
    "endstate" => Name { text: "endstate".into(), quoted: false },
};
LeftEndpoint: Name = { <LeftName>, "[*]" => Name { text: "[*]".into(), quoted: false } };
Endpoint: Name = { <Name>, "[*]" => Name { text: "[*]".into(), quoted: false } };
Label: Caption = { => Caption::Absent, ":" <label:"label"> => Caption::Present(label) };
DescriptionLabel: Caption = { => Caption::Absent, <_colon:DescriptionColon> <label:"label"> => Caption::Present(label) };
DescriptionColon: () = { ":", "attached colon" };
Arrow: bool = {
    <shaft:Hyphens> <start:@L> <head:">"> <end:@R> =>? require_adjacent((shaft.end, head), start..end).map(|()| false).map_err(|error| lalrpop_util::ParseError::User { error }),
    <start:@L> <head:"<"> <end:@R> <shaft:Hyphens> =>? require_adjacent((head + 1, shaft.start), start..end).map(|()| true).map_err(|error| lalrpop_util::ParseError::User { error }),
};
Hyphens: Range<usize> = {
    <at:"-"> => at..at + 1,
    <shaft:Hyphens> <start:@L> <at:"-"> <end:@R> =>? join_shaft(shaft, at, start..end).map_err(|error| lalrpop_util::ParseError::User { error }),
};

extern {
    type Location = usize;
    type Error = ParseFailure;
    enum Token {
        "state" => Token::State,
        "gap" => Token::Gap,
        "as" => Token::As,
        "begin" => Token::Begin,
        "end" => Token::End,
        "endstate" => Token::EndState,
        "name" => Token::Name(<Name>),
        "label" => Token::Label(<String>),
        "[*]" => Token::Pseudo,
        "{" => Token::Open,
        "}" => Token::Close,
        ":" => Token::Colon,
        "attached colon" => Token::AttachedColon,
        "<" => Token::Less(<usize>),
        ">" => Token::Greater(<usize>),
        "-" => Token::Minus(<usize>),
        "unknown" => Token::Unknown,
        "newline" => Token::Newline,
    }
}
