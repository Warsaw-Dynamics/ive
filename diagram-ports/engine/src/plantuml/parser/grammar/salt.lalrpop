    <start:@L> "[" "space" "]" <value:"caption"> <end:@R> =>? builder.leaf((LeafKind::CheckboxOff, value), start..end).map_err(|error| lalrpop_util::ParseError::User { error }),
    <start:@L> "(" "X" ")" <value:"caption"> <end:@R> =>? builder.leaf((LeafKind::RadioOn, value), start..end).map_err(|error| lalrpop_util::ParseError::User { error }),
    <start:@L> "(" ")" <value:"caption"> <end:@R> =>? builder.leaf((LeafKind::RadioOff, value), start..end).map_err(|error| lalrpop_util::ParseError::User { error }),
