    <start:@L> "*" <end:End> <finish:@R> =>? builder.span(end, start..finish).map_err(|error| lalrpop_util::ParseError::User { error }),
    <id:CellOpen> <widget:Widget> =>? builder.cell(id, widget).map_err(|error| lalrpop_util::ParseError::User { error }),
