// Original typed header evidence. Productions give the first lexical primitive its header role.
grammar(budget: &mut crate::plantuml::budget::Budget);
use crate::plantuml::parser::{header::{Atom, Word, Head, Selection, Tail, Evidence, finish}, error::ParseFailure};
pub Header: Evidence = {
    =>? budget.charge(1).map(|_| Evidence::empty()).map_err(|error| lalrpop_util::ParseError::User { error: ParseFailure::terminal(error) }),
    <head:Head> <tail:Tail> =>? finish(head, tail, budget).map_err(|error| lalrpop_util::ParseError::User { error }),
};
Head: Head = {
    "graph" => Head { atom: Atom::Word(Word::Graph), selection: Selection::Uml, graph: true, declaration: true },
    "state" => Head { atom: Atom::Word(Word::State), selection: Selection::State, graph: false, declaration: true },
    "timing" => Head { atom: Atom::Word(Word::Timing), selection: Selection::Timing, graph: false, declaration: false },
    "activity" => Head { atom: Atom::Word(Word::Activity), selection: Selection::Activity, graph: false, declaration: false },
    "if while" => Head { atom: Atom::Word(Word::IfWhile), selection: Selection::Pending, graph: false, declaration: false },
    "note" => Head { atom: Atom::Word(Word::Note), selection: Selection::Pending, graph: false, declaration: false },
    "side" => Head { atom: Atom::Word(Word::NoteSide), selection: Selection::Pending, graph: false, declaration: false },
    "left" => Head { atom: Atom::Word(Word::Left), selection: Selection::Pending, graph: true, declaration: false },
    "beside" => Head { atom: Atom::Word(Word::Beside), selection: Selection::Pending, graph: false, declaration: false },
    "over" => Head { atom: Atom::Word(Word::Over), selection: Selection::Pending, graph: false, declaration: false },
    "sequence" => Head { atom: Atom::Word(Word::Sequence), selection: Selection::Sequence, graph: false, declaration: false },
    "group" => Head { atom: Atom::Word(Word::Group), selection: Selection::Pending, graph: false, declaration: false },
    "actor database" => Head { atom: Atom::Word(Word::ActorDatabase), selection: Selection::Pending, graph: false, declaration: false },
    "direction" => Head { atom: Atom::Word(Word::LeftTop), selection: Selection::Pending, graph: true, declaration: false },
    "word" => Head { atom: Atom::Word(Word::Other), selection: Selection::Pending, graph: false, declaration: false },
    "quote" => Head { atom: Atom::Quote, selection: Selection::Pending, graph: false, declaration: false },
    "arrow" => Head { atom: Atom::Arrow, selection: Selection::Pending, graph: false, declaration: false },
    "initial" => Head { atom: Atom::Initial, selection: Selection::State, graph: false, declaration: false },
    "colon" => Head { atom: Atom::Colon, selection: Selection::Activity, graph: false, declaration: false },
    "colonpair" => Head { atom: Atom::ColonPair, selection: Selection::Pending, graph: false, declaration: false },
    "semi" => Head { atom: Atom::Semi, selection: Selection::Pending, graph: false, declaration: false },
    "openparen" => Head { atom: Atom::OpenParen, selection: Selection::Pending, graph: false, declaration: false },
    "bracket" => Head { atom: Atom::Bracket, selection: Selection::Pending, graph: true, declaration: false },
    "at" => Head { atom: Atom::At, selection: Selection::Pending, graph: false, declaration: false },
    "other" => Head { atom: Atom::Other, selection: Selection::Pending, graph: false, declaration: false },
};
Tail: Tail = {
    => Tail::empty(),
    <tail:Tail> <atom:Primitive> =>? tail.append(atom, budget).map_err(|error| lalrpop_util::ParseError::User { error }),
};
Primitive: Atom = {
    "graph" => Atom::Word(Word::Graph),
    "state" => Atom::Word(Word::State),
    "timing" => Atom::Word(Word::Timing),
    "activity" => Atom::Word(Word::Activity),
    "if while" => Atom::Word(Word::IfWhile),
    "note" => Atom::Word(Word::Note),
    "side" => Atom::Word(Word::NoteSide),
    "left" => Atom::Word(Word::Left),
    "beside" => Atom::Word(Word::Beside),
    "over" => Atom::Word(Word::Over),
    "sequence" => Atom::Word(Word::Sequence),
    "group" => Atom::Word(Word::Group),
    "actor database" => Atom::Word(Word::ActorDatabase),
    "direction" => Atom::Word(Word::LeftTop),
    "word" => Atom::Word(Word::Other),
    "quote" => Atom::Quote,
    "arrow" => Atom::Arrow,
    "initial" => Atom::Initial,
    "colon" => Atom::Colon,
    "colonpair" => Atom::ColonPair,
    "semi" => Atom::Semi,
    "openparen" => Atom::OpenParen,
    "bracket" => Atom::Bracket,
    "at" => Atom::At,
    "other" => Atom::Other,
};
extern {
    type Location = usize;
    type Error = ParseFailure;
    enum Atom {
        "graph" => Atom::Word(Word::Graph),
        "state" => Atom::Word(Word::State),
        "timing" => Atom::Word(Word::Timing),
        "activity" => Atom::Word(Word::Activity),
        "if while" => Atom::Word(Word::IfWhile),
        "note" => Atom::Word(Word::Note),
        "side" => Atom::Word(Word::NoteSide),
        "left" => Atom::Word(Word::Left),
        "beside" => Atom::Word(Word::Beside),
        "over" => Atom::Word(Word::Over),
        "sequence" => Atom::Word(Word::Sequence),
        "group" => Atom::Word(Word::Group),
        "actor database" => Atom::Word(Word::ActorDatabase),
        "direction" => Atom::Word(Word::LeftTop),
        "word" => Atom::Word(Word::Other),
        "quote" => Atom::Quote,
        "arrow" => Atom::Arrow,
        "initial" => Atom::Initial,
        "colon" => Atom::Colon,
        "colonpair" => Atom::ColonPair,
        "semi" => Atom::Semi,
        "openparen" => Atom::OpenParen,
        "bracket" => Atom::Bracket,
        "at" => Atom::At,
        "other" => Atom::Other,
    }
}
